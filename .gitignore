
### `.gitignore`

Use this:

```gitignore
# =========================
# Python
# =========================

__pycache__/
*.py[cod]
*$py.class

*.so

.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/

*.egg-info/
.installed.cfg
*.egg
MANIFEST

# =========================
# Virtual environments
# =========================

.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# =========================
# Environment / secrets
# =========================

.env
.env.*
!.env.example

*.pem
*.key

# =========================
# Jupyter
# =========================

.ipynb_checkpoints/

# =========================
# Testing / coverage
# =========================

.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# =========================
# Type checking / linters
# =========================

.mypy_cache/
.pyre/
.ruff_cache/

# =========================
# IDEs / editors
# =========================

.vscode/
.idea/

*.swp
*.swo
.DS_Store

# =========================
# OS files
# =========================

Thumbs.db
Desktop.ini

# =========================
# Logs
# =========================

*.log

# =========================
# Temporary files
# =========================

*.tmp
*.temp
*.bak
*.cache

# =========================
# Generated screenshots/cache
# =========================

_generated_screenshots/
final/_generated_screenshots/

# =========================
# Local generated files
# =========================

*.zip.tmp